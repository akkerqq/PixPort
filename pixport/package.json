{
  "name": "pixport",
  "version": "0.1.0",
  "description": "PixPort — фото с телефона сразу в нужную папку на ПК. Скан QR — и готово.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node test.js",
    "build": "node build.js",
    "dist": "node build.js && node make-ico.js && \"%LOCALAPPDATA%\\Programs\\Inno Setup 6\\ISCC.exe\" installer.iss",
    "build:native": "g++ -O2 -static -static-libgcc -static-libstdc++ -o native/hotkey-helper.exe native/hotkey-helper.cpp -lole32 -loleaut32 -luuid -lshell32 && strip native/hotkey-helper.exe",
    "menu": "node install.js",
    "menu:off": "node install.js uninstall"
  },
  "license": "MIT",
  "dependencies": {
    "busboy": "^1.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0"
  }
}
